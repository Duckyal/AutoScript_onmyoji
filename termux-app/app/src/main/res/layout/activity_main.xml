<?xml version="1.0" encoding="utf-8"?>
<!--
    项目管理器主界面布局（GUI 美化版）

    结构（垂直方向从上到下）：
     1. 顶部标题行：左侧应用名 + 副标题（占满剩余宽度），右侧「终端」描边按钮
     2. 中部白色卡片（ScrollView 包裹，小屏可滚动）：
        · ADB 无线配对内嵌面板（状态条 + 「连接 / 首次配对」互斥切换，
          默认只显示「连接」区块；点「首次配对」仅展开配对区块）
        · 「启动项目 / 终止项目」大按钮
     3. 底部小按钮行：「一键初始化」与「检查更新」（幽灵风格，主色文字+图标）

    说明：ADB 配对不再是弹窗 —— 状态检测、连接地址与首次配对输入框
    全部直接铺在主界面卡片上（连接/配对两个区块互斥，一次只展开一个，
    避免页面拥挤；逻辑见 AdbPairPanel）。
    不再有「打开网页」按钮——项目启动后悬浮遥控窗(悬浮球)会自动出现。

    所有颜色引用 ?attr/ 自定义属性，随 Theme.MainActivity 昼夜主题自动切换。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mainPageBackground"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ========== 顶部标题行 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左侧标题区：占满剩余宽度，把「终端」按钮挤到右上角 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/application_name_manager"
                android:textColor="?attr/mainTextPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/main_subtitle"
                android:textColor="?attr/mainTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 右上角「终端」按钮：描边圆角风格，复用已有会话不新建 -->
        <Button
            android:id="@+id/btn_terminal"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_outline"
            android:drawableStart="@drawable/ic_terminal"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_open_terminal"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ========== 中部卡片（ScrollView：内容超高时可滚动，不超高时垂直居中） ========== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ========== ADB 无线配对面板标题 ========== -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_adb_pair"
                    android:textColor="?attr/mainTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="?attr/mainDivider" />

                <!-- 顶部连接状态（内容与颜色由 AdbPairPanel 动态刷新） -->
                <TextView
                    android:id="@+id/tv_adb_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:padding="10dp"
                    android:text="@string/adb_loading"
                    android:textColor="?attr/mainTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ADB 分段切换控件：「连接 / 首次配对」互斥（整体一个凹槽控件，
                     选中段主色高亮，一次只展开下方对应区块） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_segment"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <Button
                        android:id="@+id/btn_connect_tab"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_sel_left"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="@string/adb_section_connect"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_pair_tab"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="@string/adb_section_pair"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 日常连接区块：地址输入框 + 「连接」按钮（默认显示） -->
                <LinearLayout
                    android:id="@+id/layout_connect_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_connect_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/adb_connect_address_hint"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="?attr/mainTextPrimary"
                        android:textColorHint="?attr/mainTextSecondary"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:minHeight="52dp"
                        android:text="@string/adb_button_connect"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- 首次配对区块（与「连接」区块互斥，默认隐藏）：
                     配对地址 + 6 位配对码 + 「配对」按钮 -->
                <LinearLayout
                    android:id="@+id/layout_pair_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/et_pair_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/adb_pair_address_hint"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="?attr/mainTextPrimary"
                        android:textColorHint="?attr/mainTextSecondary"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_pair_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/adb_pair_code_hint"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textColor="?attr/mainTextPrimary"
                        android:textColorHint="?attr/mainTextSecondary"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_pair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/adb_button_pair"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="?attr/mainDivider" />

                <!-- 大按钮：启动项目 / 终止项目（文案由代码根据真实探测结果动态切换） -->
                <Button
                    android:id="@+id/btn_project"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_btn_primary"
                    android:drawableStart="@drawable/ic_power"
                    android:drawablePadding="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/action_project_start"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ========== 底部小按钮行 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <!-- 一键初始化：容器未安装时可用 -->
        <Button
            android:id="@+id/btn_init"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_ghost"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_init"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="15sp" />

        <!-- 次要操作：检查更新 -->
        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_ghost"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_check_update"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
